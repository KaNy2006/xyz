<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/simulator.css">
<section class="page-title">
  <h1>PC Simulator</h1>
  <p>Phòng mô phỏng PC dành cho tài khoản đã hoàn thành ít nhất một đơn hàng.</p>
</section>

<% if(!unlocked){ %>
<section class="analysis-card">
  <h2>Simulator đang bị khóa</h2>
  <p>Bạn chỉ cần hoàn thành ít nhất <strong>1 đơn hàng bất kỳ</strong> để mở khóa chức năng này.</p>
  <p>Không cần mua đủ 8 linh kiện và không cần mua một bộ PC hoàn chỉnh.</p>
  <a class="btn primary" href="/products">Xem sản phẩm</a>
</section>
<% }else{ %>
<section class="builder-ready">
  <h2>Simulator đã được mở khóa</h2>
  <p>Bạn có thể tự do thử mọi linh kiện trong catalogue, không phụ thuộc vào sản phẩm đã mua.</p>
</section>

<form class="builder-panel builder-grid" action="/simulator" method="get" id="simulatorForm">
  <% slots.forEach(slot=>{ const key=fields[slot]; %>
    <label>
      <%= slot %>
      <select name="<%= key %>">
        <option value="">Chọn <%= slot %></option>
        <% products.filter(p=>p.category===slot).forEach(p=>{ %>
          <option value="<%= p.id %>" <%= selected[key]===p.id?'selected':'' %>>
            <%= p.name %>
          </option>
        <% }) %>
      </select>
    </label>
  <% }) %>
  <button class="btn primary" type="submit" id="recalculateConfigBtn">Cập nhật cấu hình</button>
  <a class="btn" href="/simulator">Đặt lại</a>
</form>

<div class="builder-summary">
  <div><strong>Đã chọn:</strong> <%= selectedCount %>/8 linh kiện</div>
  <div><strong>Trạng thái:</strong> <%= selectedCount===8?'Đã đủ cấu hình':'Đang chọn linh kiện' %></div>
</div>

<section class="section-head">
  <h2>Cấu hình đang mô phỏng</h2>
</section>

<div class="product-grid">
  <% slots.forEach(slot=>{ const p=parts[slot]; %>
    <article class="product-card">
      <% if(p){ %>
        <img src="<%= p.image %>" alt="<%= p.name %>">
        <p class="category"><%= slot %> · <%= p.brand %></p>
        <h3><%= p.name %></h3>
        <p>Hiệu năng: <strong><%= p.performance %>/100</strong></p>
        <p class="price"><%= p.price.toLocaleString('vi-VN') %>đ</p>
      <% }else{ %>
        <img src="/uploads/<%= slot.toLowerCase() %>.svg" alt="<%= slot %>">
        <p class="category"><%= slot %></p>
        <h3>Chưa chọn <%= slot %></h3>
        <p>Chọn linh kiện ở phía trên để đưa vào cấu hình mô phỏng.</p>
      <% } %>
    </article>
  <% }) %>
</div>

<section class="section-head">
  <h2>Kiểm tra tương thích</h2>
</section>

<% if(selectedCount<2){ %>
<section class="analysis-card">
  <h3>Đang chờ thêm linh kiện</h3>
  <p>Hãy chọn thêm linh kiện để hệ thống có đủ dữ liệu kiểm tra tương thích.</p>
</section>
<% }else{ %>
<section class="analysis-card">
  <h3><%= compatibility.valid?'✓ Cấu hình chưa phát hiện lỗi tương thích':'✕ Phát hiện lỗi tương thích' %></h3>
  <% compatibility.issues.forEach(issue=>{ %>
    <p class="<%= issue.level==='error'?'text-danger':'text-success' %>">
      <strong><%= issue.code %></strong> · <%= issue.message %>
    </p>
  <% }) %>
</section>
<% } %>

<% if(selectedCount===8&&compatibility.valid){ %>
<section class="builder-ready">
  <h2>Cấu hình đủ 8 linh kiện và tương thích</h2>
  <p>Cấu hình đã sẵn sàng cho bước mô phỏng lắp ráp 2D.</p>
</section>

<section class="sim2d-shell">
  <div class="sim2d-toolbar">
    <div>
      <p class="sim2d-kicker">PC ASSEMBLY LAB</p>
      <h2>Phòng lắp ráp 2D</h2>
      <p>Khung mô phỏng cơ bản. Các thao tác lắp từng linh kiện sẽ được bổ sung ở các bước tiếp theo.</p>
    </div>
    <div class="sim2d-toolbar-actions">
      <button class="btn primary" type="button" id="startAssemblyBtn">Bắt đầu lắp ráp</button>
      <button class="btn" type="button" id="restartAssemblyBtn" hidden>Làm lại lắp ráp</button>
    </div>
  </div>

  <div class="sim2d-progress" aria-label="Tiến trình lắp ráp" role="list">
    <% const assemblySteps=['Mainboard','CPU','RAM','SSD','Cooler','Case','PSU','GPU']; %>
    <% assemblySteps.forEach((step,i)=>{ %>
      <div class="sim2d-progress-item" data-step-index="<%= i %>" role="listitem" aria-current="false">
        <span><%= i+1 %></span>
        <small><%= step %></small>
      </div>
    <% }) %>
  </div>

  <div class="sim2d-layout">
    <aside class="sim2d-parts">
      <h3>Linh kiện đã chọn</h3>
      <div class="sim2d-parts-list">
        <% assemblySteps.forEach(slot=>{ const p=parts[slot]; %>
          <article class="sim2d-part" data-part="<%= slot %>">
            <img src="<%= p.image %>" alt="<%= p.name %>">
            <div>
              <strong><%= slot %></strong>
              <p><%= p.name %></p>
            </div>
          </article>
        <% }) %>
      </div>
    </aside>

    <section class="sim2d-workbench">
      <div class="sim2d-workbench-head">
        <div>
          <strong>Khu vực thao tác</strong>
          <p id="assemblyCurrentStep" aria-live="polite">Bước hiện tại: Chưa bắt đầu</p>
        </div>
        <span class="sim2d-status" id="assemblyStatus" aria-live="polite">Chưa bắt đầu</span>
      </div>

      <div class="sim2d-case">
        <div class="sim2d-case-frame">
          <span class="sim2d-case-label">CASE</span>
          <div class="sim2d-board-zone" id="mainboardZone">
            <div class="sim2d-board-placeholder" id="mainboardPlaceholder">
              <span>Vị trí Mainboard</span>
              <small>Nhấn "Bắt đầu lắp ráp" để thực hiện bước 1.</small>
            </div>
            <button class="btn primary sim2d-install-btn" type="button" id="installMainboardBtn" hidden>Lắp Mainboard</button>
            <article class="sim2d-installed-part" id="installedMainboard" hidden>
              <img src="<%= parts.Mainboard.image %>" alt="<%= parts.Mainboard.name %>">
              <div>
                <strong>Mainboard đã lắp</strong>
                <p><%= parts.Mainboard.name %></p>
              </div>
              <div class="sim2d-cpu-socket" id="cpuSocket">
                <span>CPU Socket</span>
                <button class="btn primary sim2d-cpu-btn" type="button" id="installCpuBtn" hidden>Lắp CPU</button>
                <article class="sim2d-installed-cpu" id="installedCpu" hidden>
                  <img src="<%= parts.CPU.image %>" alt="<%= parts.CPU.name %>">
                  <div>
                    <strong>CPU đã lắp</strong>
                    <p><%= parts.CPU.name %></p>
                  </div>
                </article>
              </div>
              <div class="sim2d-ram-zone" id="ramZone">
                <span>Khe RAM</span>
                <button class="btn primary sim2d-ram-btn" type="button" id="installRamBtn" hidden>Lắp RAM</button>
                <article class="sim2d-installed-ram" id="installedRam" hidden>
                  <img src="<%= parts.RAM.image %>" alt="<%= parts.RAM.name %>">
                  <div>
                    <strong>RAM đã lắp</strong>
                    <p><%= parts.RAM.name %></p>
                  </div>
                </article>
              </div>
              <div class="sim2d-ssd-zone" id="ssdZone">
                <span>Khe SSD / M.2</span>
                <button class="btn primary sim2d-ssd-btn" type="button" id="installSsdBtn" hidden>Lắp SSD</button>
                <article class="sim2d-installed-ssd" id="installedSsd" hidden>
                  <img src="<%= parts.SSD.image %>" alt="<%= parts.SSD.name %>">
                  <div>
                    <strong>SSD đã lắp</strong>
                    <p><%= parts.SSD.name %></p>
                  </div>
                </article>
              </div>
              <div class="sim2d-cooler-zone" id="coolerZone">
                <span>Vị trí Cooler</span>
                <button class="btn primary sim2d-cooler-btn" type="button" id="installCoolerBtn" hidden>Lắp Cooler</button>
                <article class="sim2d-installed-cooler" id="installedCooler" hidden>
                  <img src="<%= parts.Cooler.image %>" alt="<%= parts.Cooler.name %>">
                  <div>
                    <strong>Cooler đã lắp</strong>
                    <p><%= parts.Cooler.name %></p>
                  </div>
                </article>
              </div>
            </article>
          </div>
          <button class="btn primary sim2d-case-install-btn" type="button" id="installCaseBtn" hidden>Đưa Mainboard vào Case</button>
          <div class="sim2d-case-done-badge" id="caseInstalledBadge" hidden>
            <strong>Case đã cố định</strong>
            <span><%= parts.Case.name %></span>
          </div>
          <div class="sim2d-psu-zone" id="psuZone">
            <span>PSU</span>
            <button class="btn primary sim2d-psu-btn" type="button" id="installPsuBtn" hidden>Lắp PSU</button>
            <article class="sim2d-installed-psu" id="installedPsu" hidden>
              <img src="<%= parts.PSU.image %>" alt="<%= parts.PSU.name %>">
              <div>
                <strong>PSU đã lắp</strong>
                <p><%= parts.PSU.name %></p>
              </div>
            </article>
          </div>
          <div class="sim2d-gpu-zone" id="gpuZone">
            <span>GPU</span>
            <button class="btn primary sim2d-gpu-btn" type="button" id="installGpuBtn" hidden>Lắp GPU</button>
            <article class="sim2d-installed-gpu" id="installedGpu" hidden>
              <img src="<%= parts.GPU.image %>" alt="<%= parts.GPU.name %>">
              <div>
                <strong>GPU đã lắp</strong>
                <p><%= parts.GPU.name %></p>
              </div>
            </article>
          </div>
        </div>
      </div>

      <div class="sim2d-hint">
        <strong>Hướng dẫn</strong>
        <p id="assemblyHintText">Nhấn <strong>Bắt đầu lắp ráp</strong>. Bước đầu tiên là đặt Mainboard vào đúng vị trí trong Case.</p>
      </div>
    </section>
  </div>

  <section class="sim2d-complete" id="assemblyCompletePanel" hidden>
    <div class="sim2d-complete-head">
      <div>
        <p class="sim2d-kicker">ASSEMBLY COMPLETE</p>
        <h2>Hoàn tất lắp ráp 2D</h2>
        <p>Bạn đã hoàn thành đủ 8/8 bước lắp ráp cho cấu hình đang mô phỏng.</p>
      </div>
      <span class="sim2d-complete-badge">8/8 hoàn tất</span>
    </div>

    <div class="sim2d-complete-grid">
      <% assemblySteps.forEach(slot=>{ const p=parts[slot]; %>
        <article class="sim2d-complete-item">
          <img src="<%= p.image %>" alt="<%= p.name %>">
          <div class="sim2d-complete-item-info">
            <strong><%= slot %></strong>
            <p><%= p.name %></p>
          </div>
          <button class="btn sim-swap-btn" type="button" data-swap-field="<%= fields[slot] %>" data-swap-slot="<%= slot %>">Thay</button>
        </article>
      <% }) %>
    </div>

    <div class="sim2d-complete-actions">
      <span>Compatibility: <strong class="text-success">Đạt</strong></span>
      <span>Trạng thái lắp ráp: <strong class="text-success">Hoàn tất</strong></span>
      <span>Workload: <strong>Gaming 1440p</strong></span>
      <span class="sim-recalc-note">Thay linh kiện rồi bấm <strong>Cập nhật cấu hình</strong> để tính lại.</span>
    </div>

    <section class="sim-analysis">
      <div class="sim-analysis-head">
        <div>
          <p class="sim2d-kicker">CONFIG ANALYSIS</p>
          <h2>Phân tích cấu hình sau lắp ráp</h2>
          <p>Các chỉ số là ước tính nội bộ của mô hình mô phỏng, dùng để so sánh cấu hình trong project.</p>
        </div>
      </div>

      <div class="sim-analysis-grid">
        <article class="sim-analysis-card">
          <span class="sim-analysis-label">Công suất ước tính</span>
          <strong class="sim-analysis-value"><%= power.estimated %>W</strong>
          <p>PSU đang chọn: <strong><%= power.psu %>W</strong></p>
          <p>Khuyến nghị: <strong><%= power.recommended %>W+</strong></p>
          <p class="<%= power.status==='good'?'text-success':'text-danger' %>"><%= power.message %></p>
        </article>

        <article class="sim-analysis-card">
          <span class="sim-analysis-label">Gaming 1440p</span>
          <strong class="sim-analysis-value"><%= performance.overall %>/100</strong>
          <p>CPU <strong><%= performance.cpu %></strong> · GPU <strong><%= performance.gpu %></strong></p>
          <p>RAM <strong><%= performance.ram %></strong> · SSD <strong><%= performance.ssd %></strong></p>
          <p>Điểm tổng hợp theo trọng số Gaming 1440p.</p>
        </article>

        <article class="sim-analysis-card">
          <span class="sim-analysis-label">Bottleneck</span>
          <strong class="sim-analysis-value"><%= bottleneck.hasProblem?'Cần chú ý':'Cân bằng' %></strong>
          <p><%= bottleneck.hasProblem?'Có thành phần chênh lệch đáng kể.':'CPU/GPU/RAM chưa phát hiện nút thắt đáng kể.' %></p>
        </article>
      </div>

      <div class="sim-bottleneck-list">
        <% bottleneck.results.forEach(result=>{ %>
          <article class="sim-bottleneck-item level-<%= result.level %>">
            <strong><%= result.target %> · <%= result.level.toUpperCase() %></strong>
            <p><%= result.message %></p>
          </article>
        <% }) %>
      </div>
    </section>
  </section>
</section>
<script src="/js/simulator-assembly.js"></script>
<% }else if(selectedCount===8&&!compatibility.valid){ %>
<section class="analysis-card">
  <h2 class="text-danger">Cấu hình chưa thể lắp ráp</h2>
  <p>Hãy thay các linh kiện đang xung đột trước khi chuyển sang bước mô phỏng lắp ráp.</p>
</section>
<% } %>
<% } %>

<%- include('../partials/footer') %>
