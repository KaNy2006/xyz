<%- include('../partials/header') %>
<section class="page-title"><h1>PC Builder</h1><p>Chọn đủ linh kiện để kiểm tra tương thích, công suất và xem trước hiệu năng trước khi mua.</p></section>
<form class="builder-panel builder-grid" action="/pc-builder" method="get" id="builderForm">
<% const fields={CPU:'cpuId',Mainboard:'mainboardId',RAM:'ramId',GPU:'gpuId',SSD:'ssdId',PSU:'psuId',Case:'caseId',Cooler:'coolerId'}; %>
<% builder.slots.forEach(slot=>{ %><label><%= slot %><select name="<%= fields[slot] %>" id="<%= fields[slot] %>"><option value="">Chọn <%= slot %></option><% products.filter(p=>p.category===slot).forEach(p=>{ %><option value="<%= p.id %>" <%= selected[fields[slot]]===p.id?'selected':'' %>><%= p.name %> - <%= p.price.toLocaleString('vi-VN') %>đ</option><% }) %></select></label><% }) %>
<label>Nhu cầu đánh giá<select name="workload"><option value="gaming1080" <%= workload==='gaming1080'?'selected':'' %>>Gaming 1080p</option><option value="gaming1440" <%= workload==='gaming1440'?'selected':'' %>>Gaming 1440p</option><option value="gaming4k" <%= workload==='gaming4k'?'selected':'' %>>Gaming 4K</option><option value="productivity" <%= workload==='productivity'?'selected':'' %>>Lập trình / Render</option></select></label><button class="btn primary" type="submit">Phân tích cấu hình</button></form>
<div class="builder-summary"><div><strong>Đã chọn:</strong> <%= builder.selectedCount %>/8</div><div><strong>Tổng giá:</strong> <%= builder.totalPrice.toLocaleString('vi-VN') %>đ</div></div>
<section class="analysis-grid"><article class="analysis-card"><h2>Tương thích</h2><% builder.compatibility.issues.forEach(i=>{ %><p class="<%= i.level==='error'?'text-danger':'text-success' %>"><%= i.level==='error'?'✕':'✓' %> <%= i.message %></p><% }) %></article>
<article class="analysis-card"><h2>Công suất</h2><p>Ước tính: <strong><%= builder.power.estimated %>W</strong></p><p>Khuyến nghị: <strong><%= builder.power.recommended %>W</strong></p><p>PSU: <strong><%= builder.power.psu %>W</strong></p><p><%= builder.power.message %></p></article>
<article class="analysis-card"><h2>Hiệu năng xem trước</h2><% if(builder.performance.complete){ %><p>CPU: <strong><%= builder.performance.cpu %>/100</strong></p><p>GPU: <strong><%= builder.performance.gpu %>/100</strong></p><p>RAM: <strong><%= builder.performance.ram %>/100</strong></p><p>SSD: <strong><%= builder.performance.ssd %>/100</strong></p><p class="score-big"><%= builder.performance.overall %>/100</p><% }else{ %><p>Chọn CPU, GPU, RAM và SSD để xem điểm tương đối.</p><% } %></article></section>
<% if(builder.complete&&builder.compatibility.valid){ %><section class="builder-ready"><h2>Cấu hình sẵn sàng để mua</h2><p>Mô phỏng lắp ráp đầy đủ sẽ được mở sau khi cấu hình được mua và ghi nhận trong hệ thống.</p></section><% } %>
<section class="section-head"><h2>Hướng nâng cấp tham khảo</h2></section><div class="upgrade-grid"><% Object.entries(builder.recommendations).forEach(([cat,list])=>{if(list.length){ %><article class="analysis-card"><h3><%= cat %></h3><% list.forEach(p=>{ %><p><a href="/products/<%= p.id %>"><%= p.name %></a> · <%= p.performance %>/100</p><% }) %></article><% }}) %></div>
<script src="/js/pc-builder-ajax.js"></script><%- include('../partials/footer') %>