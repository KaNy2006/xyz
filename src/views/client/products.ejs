<%- include('../partials/header') %><section class="page-title"><h1>Sản phẩm</h1><p>Linh kiện máy tính dành cho nhu cầu build và nâng cấp cấu hình.</p></section>
<form class="filter-bar" action="/products" method="get"><input type="search" name="keyword" placeholder="Tên hoặc hãng" value="<%= filters.keyword||'' %>"><select name="category"><option value="">Tất cả danh mục</option><% categories.forEach(c=>{ %><option value="<%= c %>" <%= filters.category===c?'selected':'' %>><%= c %></option><% }) %></select><select name="minPerformance"><option value="">Mọi hiệu năng</option><option value="80" <%= filters.minPerformance==='80'?'selected':'' %>>Từ 80 điểm</option><option value="90" <%= filters.minPerformance==='90'?'selected':'' %>>Từ 90 điểm</option></select><button class="btn primary">Lọc</button></form>
<div class="product-grid"><% products.forEach(p=>{ %><article class="product-card"><img src="<%= p.image %>" alt="<%= p.name %>"><p class="category"><%= p.category %> · <%= p.brand %></p><h3><%= p.name %></h3><p>Hiệu năng: <strong><%= p.performance %>/100</strong></p><p class="price"><%= p.price.toLocaleString('vi-VN') %>đ</p><div class="card-actions"><a class="btn small" href="/products/<%= p.id %>">Chi tiết</a><% if(user){ %><form action="/cart/add/<%= p.id %>" method="post"><button class="btn small primary">Thêm</button></form><% }else{ %><a class="btn small primary" href="/login">Đăng nhập để mua</a><% } %></div></article><% }) %></div><% if(!products.length){ %><p class="empty-state">Không tìm thấy linh kiện phù hợp.</p><% } %><%- include('../partials/footer') %>