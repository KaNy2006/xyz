<%- include('../partials/header') %><section class="page-title"><h1>Giỏ hàng</h1></section><div class="cart-list"><% cart.forEach(item=>{ %><article class="cart-item"><img src="<%= item.product.image %>" alt=""><div><h3><%= item.product.name %></h3><p><%= item.product.price.toLocaleString('vi-VN') %>đ</p></div><form class="quantity-form" action="/cart/update/<%= item.product.id %>" method="post"><input type="number" name="quantity" min="1" max="<%= item.product.stock %>" value="<%= item.quantity %>"><button>Lưu</button></form><form action="/cart/remove/<%= item.product.id %>" method="post"><button class="danger">Xóa</button></form></article><% }) %></div><% if(cart.length){ %><section class="checkout-box"><h2>Tổng: <%= total.toLocaleString('vi-VN') %>đ</h2><form action="/checkout" method="post"><button class="btn primary">Đặt hàng</button></form></section><% }else{ %><p class="empty-state">Giỏ hàng đang trống.</p><% } %><%- include('../partials/footer') %>