<%- include('../partials/header') %><div class="admin-layout"><%- include('../partials/admin_sidebar') %><section class="admin-content"><h1>Quản lý linh kiện</h1><form class="admin-form" action="/admin/products" method="post"><input name="name" placeholder="Tên" required><input name="brand" placeholder="Hãng" required><select name="category"><% categories.forEach(c=>{ %><option value="<%= c %>"><%= c %></option><% }) %></select><input name="price" type="number" placeholder="Giá" required><input name="stock" type="number" placeholder="Kho" required><input name="performance" type="number" min="1" max="100" value="70"><button class="btn primary">Thêm</button></form><div class="admin-product-list"><% products.forEach(p=>{ %><article class="admin-product-row"><form class="product-edit-form" action="/admin/products/<%= p.id %>/update" method="post"><input name="name" value="<%= p.name %>"><input name="brand" value="<%= p.brand %>"><select name="category"><% categories.forEach(c=>{ %><option value="<%= c %>" <%= p.category===c?'selected':'' %>><%= c %></option><% }) %></select><input name="price" type="number" value="<%= p.price %>"><input name="stock" type="number" value="<%= p.stock %>"><input name="performance" type="number" value="<%= p.performance %>"><button class="btn small primary">Sửa</button></form><form action="/admin/products/<%= p.id %>/delete" method="post"><button class="btn small danger">Xóa</button></form></article><% }) %></div></section></div><%- include('../partials/footer') %>