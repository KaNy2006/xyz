<%- include('../partials/header') %><div class="admin-layout"><%- include('../partials/admin_sidebar') %><section class="admin-content"><h1>Dashboard</h1><div class="metric-grid"><article><span>Doanh thu</span><strong><%= summary.revenue.toLocaleString('vi-VN') %>đ</strong></article><article><span>Đơn hàng</span><strong><%= summary.orders %></strong></article><article><span>Chờ duyệt</span><strong><%= summary.pending %></strong></article></div><h2>Đơn gần đây</h2><table class="admin-table"><tr><th>Mã</th><th>Khách hàng</th><th>Tổng</th><th>Trạng thái</th></tr><% orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= o.customer %></td><td><%= o.total.toLocaleString('vi-VN') %>đ</td><td><%= o.status %></td></tr><% }) %></table></section></div><%- include('../partials/footer') %>