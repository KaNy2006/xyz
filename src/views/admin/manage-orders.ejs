<%- include('../partials/header') %><div class="admin-layout"><%- include('../partials/admin_sidebar') %><section class="admin-content"><h1>Quản lý đơn hàng</h1><table class="admin-table"><tr><th>Mã</th><th>Khách</th><th>Ngày</th><th>Tổng</th><th>Trạng thái</th><th>Cập nhật</th></tr><% orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= o.customer %></td><td><%= o.createdAt %></td><td><%= o.total.toLocaleString('vi-VN') %>đ</td><td><%= o.status %></td><td><form action="/admin/orders/<%= o.id %>/status" method="post" class="status-form"><select name="status"><% ['Chờ duyệt','Đang giao','Hoàn tất','Đã hủy'].forEach(s=>{ %><option value="<%= s %>" <%= o.status===s?'selected':'' %>><%= s %></option><% }) %></select><button>Lưu</button></form></td></tr><% }) %></table></section></div><%- include('../partials/footer') %>